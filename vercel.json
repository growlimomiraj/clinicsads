{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.clinicsads.com"
        }
      ],
      "destination": "https://clinicsads.com/:path*",
      "permanent": true
    }
  ]
}
